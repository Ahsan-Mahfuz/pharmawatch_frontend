# Where the PharmaWatch API lives. Leave it unset and the app talks to
# http://localhost:5000, which is where `pnpm dev` in pharmawatch_backend listens.
# This value is inlined at build time, so change it before `next build`.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Absolute URL of this site, used for canonical links, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
