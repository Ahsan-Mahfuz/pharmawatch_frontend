{
  "name": "pharmawatch_frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node api.js && next dev",
    "build": "node api.js && next build",
    "start": "node api.js && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cross-env NEXT_PUBLIC_API_URL=http://localhost:5055 next build && cross-env NEXT_PUBLIC_API_URL=http://localhost:5055 playwright test",
    "test:e2e:ui": "cross-env NEXT_PUBLIC_API_URL=http://localhost:5055 next build && cross-env NEXT_PUBLIC_API_URL=http://localhost:5055 playwright test --ui"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^9.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
